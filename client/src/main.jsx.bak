import React, { useEffect, useState } from 'react'
import { createRoot } from 'react-dom/client'
import { ArrowRight, Check, Compass, Home, LogOut, MapPin, Menu, Package, Plus, UserRound, X } from 'lucide-react'
import './styles.css'

const API = import.meta.env.VITE_API_URL
const emptyRegister = { name: '', email: '', mobile: '', address: '', username: '', password: '', confirmPassword: '', location: null }

async function request(path, options = {}) {
  const response = await fetch(`${API}${path}`, { headers: { 'Content-Type': 'application/json', ...(options.token ? { Authorization: `Bearer ${options.token}` } : {}) }, ...options })
  const data = await response.json()
  if (!response.ok) throw new Error(data.message || 'Something went wrong.')
  return data
}

function Field({ label, name, type = 'text', value, onChange, placeholder, required = true }) {
  return <label className="field"><span>{label}</span><input name={name} type={type} value={value} onChange={onChange} placeholder={placeholder} required={required} /></label>
}
function Button({ children, variant = 'primary', type = 'submit', onClick, disabled = false }) { return <button className={`button ${variant}`} type={type} onClick={onClick} disabled={disabled}>{children}</button> }
function Brand() { return <div className="brand"><div className="brand-mark">SB</div><div><strong>Shree brahmani</strong><span>krupa matla ghar</span></div></div> }

function AuthShell({ children, eyebrow, title, detail, onHome, showShopImage = false }) {
  return <main className="auth-page"><div className={`auth-visual ${showShopImage ? 'shop-visual' : ''}`}>{showShopImage && <img className="shop-image" src="/shop-image.jpg" alt="Shree brahmani krupa matla ghar shop" />}<div className="sun"></div><div className="visual-copy"><span className="eyebrow">{eyebrow}</span><h1>Rooted in trust.<br /><em>Made for home.</em></h1><p>A warm, secure place to begin your next chapter.</p></div><div className="vertical-note">SHREE BRAHMANI KRUPA MATLA GHAR <span>EST. 2024</span></div></div><section className="auth-panel"><Brand /><div className="form-wrap"><span className="eyebrow red">{eyebrow}</span><h2>{title}</h2><p className="detail">{detail}</p>{children}</div><button className="quiet-link" onClick={onHome}>Back to welcome</button></section></main>
}

function Login({ go, onLogin }) {
  const [form, setForm] = useState({ username: '', password: '' }); const [error, setError] = useState(''); const update = e => setForm({ ...form, [e.target.name]: e.target.value })
  async function submit(e) { e.preventDefault(); setError(''); try { const data = await request('/auth/login', { method: 'POST', body: JSON.stringify(form) }); onLogin(data) } catch (err) { setError(err.message) } }
  return <AuthShell showShopImage eyebrow="Welcome back" title="Sign in to your space" detail="Your home dashboard is waiting for you."><form onSubmit={submit}><Field label="Username" name="username" value={form.username} onChange={update} placeholder="your username" /><Field label="Password" name="password" type="password" value={form.password} onChange={update} placeholder="Your password" />{error && <p className="error">{error}</p>}<Button>Sign in <ArrowRight size={17} /></Button></form><div className="form-footer"><button className="text-button" onClick={() => go('forgot')}>Reset password</button><span>New here? <button className="text-button" onClick={() => go('register')}>Create an account</button></span><button className="text-button admin-access" onClick={() => go('admin-login')}>Admin access</button></div></AuthShell>
}

function Register({ go, onLogin }) {
  const [form, setForm] = useState(emptyRegister); const [step, setStep] = useState(1); const [error, setError] = useState(''); const update = e => setForm({ ...form, [e.target.name]: e.target.value })
  function updateMobile(e) { setForm({ ...form, mobile: e.target.value.replace(/\D/g, '').slice(0, 10) }) }
  function locate() { if (!navigator.geolocation) return setError('Location is not available in this browser.'); navigator.geolocation.getCurrentPosition(({ coords }) => setForm({ ...form, location: { lat: coords.latitude, lng: coords.longitude }, address: `Pinned location (${coords.latitude.toFixed(4)}, ${coords.longitude.toFixed(4)})` }), () => setError('Location permission was not granted.')) }
  function nextStep(e) { e.preventDefault(); if (![form.name, form.email, form.mobile, form.address].every(Boolean)) return setError('Please complete your personal information.'); if (form.mobile.length !== 10) return setError('Enter a valid 10-digit Indian mobile number.'); setError(''); setStep(2) }
  async function submit(e) { e.preventDefault(); setError(''); if (form.password !== form.confirmPassword) return setError('Passwords do not match.'); try { const data = await request('/auth/register', { method: 'POST', body: JSON.stringify({ ...form, mobile: `+91${form.mobile}` }) }); onLogin(data) } catch (err) { setError(err.message) } }
  return <AuthShell eyebrow="A new beginning" title="Create your account" detail={step === 1 ? 'First, tell us a little about yourself.' : 'Now choose the details you will use to sign in.'}><div className="step-indicator"><span className={step === 1 ? 'current' : 'complete'}>{step > 1 ? '✓' : '1'} Personal information</span><span className={step === 2 ? 'current' : ''}>2 Account details</span></div>{step === 1 ? <form onSubmit={nextStep} className="register-form"><Field label="Full name" name="name" value={form.name} onChange={update} placeholder="Your name" /><label className="field"><span>Mobile number</span><div className="mobile-input"><b>+91</b><input name="mobile" type="tel" value={form.mobile} onChange={updateMobile} placeholder="00000 00000" required /></div></label><Field label="Email address" name="email" type="email" value={form.email} onChange={update} placeholder="you@example.com" /><label className="field"><span>Address</span><div className="input-action"><input name="address" value={form.address} onChange={update} placeholder="Your home address" required /><button type="button" title="Use your current map location" onClick={locate}><MapPin size={17} /></button></div></label>{error && <p className="error">{error}</p>}<Button>Continue <ArrowRight size={17} /></Button></form> : <form onSubmit={submit} className="register-form"><Field label="Create username" name="username" value={form.username} onChange={update} placeholder="Choose a username" /><Field label="Create password" name="password" type="password" value={form.password} onChange={update} placeholder="8+ characters" /><Field label="Confirm password" name="confirmPassword" type="password" value={form.confirmPassword} onChange={update} placeholder="Repeat your password" />{error && <p className="error">{error}</p>}<Button>Create account <ArrowRight size={17} /></Button><button className="back-step" type="button" onClick={() => { setError(''); setStep(1) }}>Back to personal information</button></form>}<div className="form-footer single">Already registered? <button className="text-button" onClick={() => go('login')}>Sign in</button></div></AuthShell>
}

function Forgot({ go }) {
  const [form, setForm] = useState({ name: '', email: '', username: '', newPassword: '' }); const [done, setDone] = useState(false); const [error, setError] = useState(''); const update = e => setForm({ ...form, [e.target.name]: e.target.value })
  async function submit(e) { e.preventDefault(); setError(''); try { await request('/auth/forgot', { method: 'POST', body: JSON.stringify(form) }); setDone(true) } catch (err) { setError(err.message) } }
  if (done) return <AuthShell eyebrow="All set" title="Password updated" detail="Your new password is ready. Sign in with it now."><div className="success"><Check size={22} /><p>Password changed successfully.</p></div><Button type="button" onClick={() => go('login')}>Return to sign in <ArrowRight size={17} /></Button></AuthShell>
  return <AuthShell eyebrow="Account recovery" title="Reset your password" detail="Confirm your account details, then choose a new password."><form onSubmit={submit}><Field label="Full name" name="name" value={form.name} onChange={update} placeholder="Your name" /><Field label="Email address" name="email" type="email" value={form.email} onChange={update} placeholder="you@example.com" /><Field label="Username" name="username" value={form.username} onChange={update} placeholder="Your username" /><Field label="New password" name="newPassword" type="password" value={form.newPassword} onChange={update} placeholder="8+ characters" />{error && <p className="error">{error}</p>}<Button>Update password <ArrowRight size={17} /></Button></form><div className="form-footer single"><button className="text-button" onClick={() => go('login')}>Back to sign in</button></div></AuthShell>
}

function Welcome({ go }) { return <main className="welcome"><nav><Brand /><button className="nav-login" onClick={() => go('login')}>Sign in <ArrowRight size={16} /></button></nav><section className="welcome-hero"><div><span className="eyebrow red">A place to call your own</span><h1>Make room for<br /><em>what matters.</em></h1><p>Welcome to a simpler way to manage your home, your details, and the life you are building around them.</p><div className="hero-actions"><Button type="button" onClick={() => go('register')}>Create your account <ArrowRight size={17} /></Button><button className="outline-button" onClick={() => go('login')}>I already have an account</button></div></div><div className="main-shop-image"><img src="/shop-image.jpg" alt="Shree brahmani krupa matla ghar shop" /><div>SHREE BRAHMANI<br /><b>KRUPA MATLA GHAR</b></div></div></section></main> }

function ProfileView({ user, token, onUpdate, onBack }) { const [form, setForm] = useState({ name: user.name, email: user.email, mobile: (user.mobile || '').replace('+91', ''), address: user.address, profileImage: user.profileImage || '' }); const [error, setError] = useState(''); const [success, setSuccess] = useState(''); const update = e => setForm({ ...form, [e.target.name]: e.target.value }); function handleImageUpload(e) { const file = e.target.files[0]; if (file) { const reader = new FileReader(); reader.onload = () => setForm({ ...form, profileImage: reader.result }); reader.readAsDataURL(file) } } async function submit(e) { e.preventDefault(); setError(''); setSuccess(''); try { const data = await request('/auth/me', { method: 'PUT', token: token, body: JSON.stringify({ name: form.name, email: form.email, mobile: `+91${form.mobile.replace(/\D/g, '').slice(0, 10)}`, address: form.address, profileImage: form.profileImage || null }) }); onUpdate(data.user); setSuccess('Profile updated!'); setTimeout(() => onBack(), 1500) } catch (err) { setError(err.message) } } return <section className="profile-page"><button className="back-step" onClick={onBack}>← Back to products</button><div className="profile-header"><div className="profile-cover">{form.profileImage ? <img src={form.profileImage} alt={user.name} /> : <div className="profile-placeholder">{user.name.charAt(0).toUpperCase()}</div>}</div><label className="image-upload"><input type="file" accept="image/*" onChange={handleImageUpload} /><span>Change photo</span></label></div><form onSubmit={submit} className="profile-form"><div className="form-section"><h3>Basic Information</h3><Field label="Full name" name="name" value={form.name} onChange={update} /><Field label="Email address" name="email" type="email" value={form.email} onChange={update} /></div><div className="form-section"><h3>Contact Details</h3><label className="field"><span>Mobile number</span><div className="mobile-input"><b>+91</b><input name="mobile" type="tel" value={form.mobile} onChange={e => setForm({...form, mobile: e.target.value.replace(/\D/g, '').slice(0, 10)})} placeholder="00000 00000" required /></div></label><Field label="Address" name="address" value={form.address} onChange={update} /></div>{error && <p className="error">{error}</p>}{success && <p className="success">{success}</p>}<Button>Save changes <ArrowRight size={17} /></Button></form></section> }

function AdminLogin({ go, onLogin }) { const [form, setForm] = useState({ username: '', password: '', securityPassword: '' }); const [error, setError] = useState(''); const update = e => setForm({ ...form, [e.target.name]: e.target.value }); async function submit(e) { e.preventDefault(); try { onLogin(await request('/admin/login', { method: 'POST', body: JSON.stringify(form) })) } catch (err) { setError(err.message) } } return <AuthShell eyebrow="Administration" title="Admin sign in" detail="Manage the products in your store."><form onSubmit={submit}><Field label="Admin username" name="username" value={form.username} onChange={update} placeholder="Admin username" /><Field label="Password" name="password" type="password" value={form.password} onChange={update} placeholder="Admin password" /><Field label="Security pass" name="securityPassword" type="password" value={form.securityPassword} onChange={update} placeholder="Additional security pass" />{error && <p className="error">{error}</p>}<Button>Open admin panel <ArrowRight size={17} /></Button></form><div className="form-footer single"><button className="text-button" onClick={() => go('login')}>Back to sign in</button></div></AuthShell> }
function AdminPage({ session, logout }) { const [open, setOpen] = useState(false); const [products, setProducts] = useState([]); const [showAdd, setShowAdd] = useState(false); const [form, setForm] = useState({ name: '', category: '', price: '', stock: '', description: '' }); const [error, setError] = useState(''); const update = e => setForm({ ...form, [e.target.name]: e.target.value }); useEffect(() => { request('/admin/products', { token: session.token }).then(data => setProducts(data.products)).catch(err => setError(err.message)) }, [session.token]); async function addProduct(e) { e.preventDefault(); setError(''); try { const data = await request('/admin/products', { method: 'POST', token: session.token, body: JSON.stringify(form) }); setProducts([data.product, ...products]); setForm({ name: '', category: '', price: '', stock: '', description: '' }); setShowAdd(false) } catch (err) { setError(err.message) } } return <main className="app-page admin-page"><aside className={open ? 'open' : ''}><Brand /><div className="side-links"><button className="active"><Package size={18} /> Products</button><button onClick={logout}><LogOut size={18} /> Log out</button></div></aside><div className="app-content"><button className="menu-button" onClick={() => setOpen(!open)}>{open ? <X /> : <Menu />}</button><header className="admin-header"><span className="eyebrow red">Store management</span><h1>Products</h1><p>Keep your product catalogue fresh and ready.</p><button className="button add-product" type="button" onClick={() => setShowAdd(!showAdd)}><Plus size={17} /> Add product</button></header>{showAdd && <form className="product-form" onSubmit={addProduct}><div className="two-col"><Field label="Product name" name="name" value={form.name} onChange={update} placeholder="e.g. Brass matka" /><Field label="Category" name="category" value={form.category} onChange={update} placeholder="e.g. Matka" /></div><div className="two-col"><Field label="Price (INR)" name="price" type="number" value={form.price} onChange={update} placeholder="0" /><Field label="Stock" name="stock" type="number" value={form.stock} onChange={update} placeholder="0" /></div><Field label="Description" name="description" value={form.description} onChange={update} placeholder="A short product description" required={false} />{error && <p className="error">{error}</p>}<Button>Save product <Check size={17} /></Button></form>}<section className="products-grid">{products.length ? products.map(product => <article className="product-card" key={product._id}><div className="product-icon"><Package size={22} /></div><div><h3>{product.name}</h3><span>{product.category}</span><p>{product.description || 'No description added.'}</p></div><strong>₹{product.price.toLocaleString('en-IN')}</strong><small>{product.stock} in stock</small></article>) : <div className="empty-state product-empty"><Package size={30} /><span>No products yet</span><small>Add your first product above.</small></div>}</section></div></main> }
function ProductImages({ images, mainImage, onMain }) { return <div className="image-picker"><div className="image-previews">{images.map((image, index) => <button className={image === mainImage ? 'selected' : ''} type="button" key={`${image.slice(0, 12)}-${index}`} onClick={() => onMain(image)}><img src={image} alt={`Product preview ${index + 1}`} /><span>{image === mainImage ? 'Main' : 'Set main'}</span></button>)}</div></div> }
function ProductEditor({ session, product, onSaved, onBack }) { const initial = product || { name: '', category: '', price: '', quantity: '', description: '', images: [], mainImage: '', attributes: [] }; const [form, setForm] = useState(initial); const [error, setError] = useState(''); const update = e => setForm({ ...form, [e.target.name]: e.target.value }); function addImages(e) { [...e.target.files].forEach(file => { const reader = new FileReader(); reader.onload = () => setForm(current => ({ ...current, images: [...current.images, reader.result], mainImage: current.mainImage || reader.result })); reader.readAsDataURL(file) }) } function addAttribute() { setForm({ ...form, attributes: [...form.attributes, { name: 'Size', values: [''] }] }) } function updateAttribute(index, key, value) { const attributes = form.attributes.map((attribute, current) => current === index ? { ...attribute, [key]: key === 'values' ? value.split(',').map(item => item.trim()) : value } : attribute); setForm({ ...form, attributes }) } async function submit(e) { e.preventDefault(); setError(''); try { const data = await request(product ? `/admin/products/${product._id}` : '/admin/products', { method: product ? 'PUT' : 'POST', token: session.token, body: JSON.stringify(form) }); onSaved(data.product) } catch (err) { setError(err.message) } } return <section className="product-editor"><button className="back-step" type="button" onClick={onBack}>← Back to products</button><h2>{product ? 'Edit product' : 'Create a product'}</h2><p className="detail">Required: product name, quantity, and price. Add as much detail as your customers need.</p><form onSubmit={submit}><div className="two-col"><Field label="Product name *" name="name" value={form.name} onChange={update} placeholder="e.g. Hand-painted pot" /><Field label="Category" name="category" value={form.category} onChange={update} placeholder="e.g. Pots" /></div><div className="two-col"><Field label="Quantity *" name="quantity" type="number" value={form.quantity} onChange={update} placeholder="0" /><Field label="Price (INR) *" name="price" type="number" value={form.price} onChange={update} placeholder="0" /></div><label className="field"><span>Product images</span><input type="file" accept="image/*" multiple onChange={addImages} /></label>{form.images.length > 0 && <ProductImages images={form.images} mainImage={form.mainImage} onMain={image => setForm({ ...form, mainImage: image })} />}<Field label="Basic information" name="description" value={form.description} onChange={update} placeholder="Describe the pot, material, care, and use" required={false} /><div className="attribute-heading"><span>Optional product information</span><button type="button" className="text-button" onClick={addAttribute}><Plus size={14} /> Add info</button></div>{form.attributes.map((attribute, index) => <div className="attribute-row" key={index}><select value={attribute.name} onChange={e => updateAttribute(index, 'name', e.target.value)}><option>Size</option><option>Colour</option><option>Material</option><option>Capacity</option><option>Style</option><option>Custom</option></select><input value={attribute.values.join(', ')} onChange={e => updateAttribute(index, 'values', e.target.value)} placeholder="Add values, separated by commas" /></div>)}{error && <p className="error">{error}</p>}<Button>{product ? 'Save changes' : 'Create product'} <Check size={17} /></Button></form></section> }
function AdminProducts({ session, logout }) { const [open, setOpen] = useState(false); const [products, setProducts] = useState([]); const [editing, setEditing] = useState(null); const [error, setError] = useState(''); useEffect(() => { request('/admin/products', { token: session.token }).then(data => setProducts(data.products)).catch(err => setError(err.message)) }, [session.token]); function saved(product) { setProducts(current => { const exists = current.some(item => item._id === product._id); return exists ? current.map(item => item._id === product._id ? product : item) : [product, ...current] }); setEditing(null) } return <main className="app-page admin-page"><aside className={open ? 'open' : ''}><Brand /><div className="side-links"><button className={!editing ? 'active' : ''} onClick={() => setEditing(null)}><Package size={18} /> Products</button><button onClick={logout}><LogOut size={18} /> Log out</button></div></aside><div className="app-content"><button className="menu-button" onClick={() => setOpen(!open)}>{open ? <X /> : <Menu />}</button>{editing ? <ProductEditor session={session} product={editing === 'new' ? null : editing} onSaved={saved} onBack={() => setEditing(null)} /> : <><header className="admin-header"><span className="eyebrow red">Store management</span><h1>Products</h1><p>Build a clear catalogue for your customers.</p><button className="button add-product" type="button" onClick={() => setEditing('new')}><Plus size={17} /> Add product</button></header>{error && <p className="error">{error}</p>}<section className="products-grid">{products.length ? products.map(product => <button className="product-card product-card-button" key={product._id} onClick={() => setEditing(product)}><div className="product-icon">{product.mainImage ? <img src={product.mainImage} alt="" /> : <Package size={22} />}</div><div><h3>{product.name}</h3><span>{product.category || 'Product'}</span><p>{product.description || 'Open to add more product information.'}</p></div><strong>₹{product.price.toLocaleString('en-IN')}</strong><small>{product.quantity ?? product.stock} in stock</small></button>) : <div className="empty-state product-empty"><Package size={30} /><span>No products yet</span><small>Add your first product above.</small></div>}</section></>}</div></main> }
function UserProducts({ user, logout }) { const [open, setOpen] = useState(false); const [products, setProducts] = useState([]); const [selected, setSelected] = useState(null); useEffect(() => { request('/products').then(data => setProducts(data.products)) }, []); return <main className="app-page"><aside className={open ? 'open' : ''}><Brand /><div className="side-links"><button onClick={() => setSelected(null)} className={!selected ? 'active' : ''}><Package size={18} /> Products</button><button onClick={logout}><LogOut size={18} /> Log out</button></div></aside><div className="app-content"><button className="menu-button" onClick={() => setOpen(!open)}>{open ? <X /> : <Menu />}</button>{selected ? <section className="product-detail-page"><button className="back-step" onClick={() => setSelected(null)}>← Back to products</button>{selected.mainImage && <img className="detail-image" src={selected.mainImage} alt={selected.name} />}<span className="eyebrow red">{selected.category || 'Our collection'}</span><h1>{selected.name}</h1><strong className="detail-price">₹{selected.price.toLocaleString('en-IN')}</strong><p>{selected.description || 'A beautiful piece from our collection.'}</p><div className="detail-facts"><span><b>Available</b>{selected.quantity ?? selected.stock} pieces</span>{selected.attributes?.map(attribute => <span key={attribute.name}><b>{attribute.name}</b>{attribute.values.join(', ')}</span>)}</div></section> : <><header><span className="eyebrow red">Our collection</span><h1>Products</h1><p>Discover pieces made for your home.</p></header><section className="products-grid user-products-grid">{products.map(product => <button className="product-card product-card-button" key={product._id} onClick={() => setSelected(product)}><div className="product-image">{product.mainImage ? <img src={product.mainImage} alt={product.name} /> : <Package size={28} />}</div><h3>{product.name}</h3><span>{product.category || 'Product'}</span><strong>₹{product.price.toLocaleString('en-IN')}</strong></button>)}</section></>}</div></main> }
function App() { const [view, setView] = useState('welcome'); const [session, setSession] = useState(() => JSON.parse(localStorage.getItem('shree-session') || 'null')); const [adminSession, setAdminSession] = useState(() => JSON.parse(localStorage.getItem('shree-admin-session') || 'null')); useEffect(() => { if (session) setView('home'); else if (adminSession) setView('admin') }, [])
  function login(data) { localStorage.setItem('shree-session', JSON.stringify(data)); setSession(data); setView('home') } function adminLogin(data) { localStorage.setItem('shree-admin-session', JSON.stringify(data)); setAdminSession(data); setView('admin') } function logout() { localStorage.removeItem('shree-session'); localStorage.removeItem('shree-admin-session'); setSession(null); setAdminSession(null); setView('welcome') } if (adminSession) return <AdminProducts session={adminSession} logout={logout} />; if (session) return <UserProducts user={session.user} logout={logout} />; if (view === 'login') return <Login go={setView} onLogin={login} />; if (view === 'register') return <Register go={setView} onLogin={login} />; if (view === 'forgot') return <Forgot go={setView} />; if (view === 'admin-login') return <AdminLogin go={setView} onLogin={adminLogin} />; return <Welcome go={setView} /> }

createRoot(document.getElementById('root')).render(<App />)
